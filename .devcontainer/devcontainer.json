{
  "name": "AKSCS14App (Arimitsu ga Kangaeta Saikyo no C#14App)",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",

  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "http://localhost:5080"
  },

  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": {
      "label": "AKSCS14App.Api (Swagger)",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "dotnet restore AKSCS14App.slnx && dotnet dev-certs https && dotnet tool restore && dotnet husky install",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp"
      ],
      "settings": {
        "dotnet.defaultSolution": "AKSCS14App.slnx"
      }
    }
  }
}
